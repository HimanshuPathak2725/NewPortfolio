---
import type { CollectionEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import EssayFigure from './EssayFigure.astro';
import { figures, type FigureId } from '../../lib/essays/figures';
import '@fontsource-variable/inter';
import '../../styles/research-essay.css';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const processor = await createMarkdownProcessor({ syntaxHighlight: 'prism' });
const raw = (post.body ?? '').split(/<!-- figure:(\w+) -->/g);
let figureNumber=0;
const parts = await Promise.all(raw.map(async(value,index) => {
  if(index%2) {
    if(!(value in figures)) throw new Error(`Unknown essay figure: ${value}`);
    return { kind:'figure', id:value as FigureId, number:++figureNumber, html:'' };
  }
  return {kind:'prose',id:'potential' as FigureId,number:0,html:(await processor.render(value)).code};
}));
const plain = (post.body ?? '').replace(/<math[\s\S]*?<\/math>/g,' equation ').replace(/<[^>]+>/g,'');
const minutes = Math.ceil(plain.split(/\s+/).length/200);
const date=post.data.pubDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<article class="research-essay">
  <header class="essay-header">
    <a href="/posts/" class="back-link">← All writing</a>
    <p class="essay-kicker">Research essay · {post.data.tags[0]?.replaceAll('-',' ')}</p>
    <h1>{post.data.title}</h1>
    <p class="essay-deck">{post.data.description}</p>
    <p class="essay-byline">Himanshu Pathak <span aria-hidden="true">/</span> <time datetime={post.data.pubDate.toISOString()}>{date}</time> <span aria-hidden="true">/</span> {minutes} min read</p>
  </header>
  {parts.map(part=>part.kind==='figure'?<EssayFigure id={part.id} number={part.number}/>:<div class="prose essay-prose" set:html={part.html}/>)}
  <footer class="essay-footer"><a href="/posts/">← More writing</a><a href="#main-content">Back to the beginning ↑</a></footer>
</article>
<script>
  import { initEssayFigures } from '../../lib/essays/motion';
  initEssayFigures();
</script>
