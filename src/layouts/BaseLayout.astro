---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean;
}

const {
  title = 'Himanshu Pathak — Reinforcement Learning Researcher',
  description = 'Personal portfolio of Himanshu Pathak, Reinforcement Learning research intern. Projects, models, and writing on RL.',
  image,
  wide = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {image && <meta property="og:image" content={new URL(image, canonicalURL)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
    <script is:inline>
      const theme = (() => {
        let stored;
        try { stored = localStorage.getItem('theme'); } catch {}
        if (stored === 'dark' || stored === 'light') return stored;
        return 'light';
      })();
      if (theme === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={['site-shell', { 'site-shell--wide': wide }]}>
      <Header />
      <main id="main-content" class="page-main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import { initMotion } from '../lib/motion';
      initMotion();
    </script>
  </body>
</html>
